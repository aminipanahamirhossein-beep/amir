# Committed placeholder defaults for local/Base44 development.
# Listed BEFORE /run/base44/app.env in compose, so a real value supplied through
# the platform dashboard always wins (later env_file entries override earlier ones).
#
# Everything here is optional: the site runs fully without it. Outbound email is
# the only feature that depends on it — contact submissions are always stored in
# the database (see README, "Contact form").

# Where new contact enquiries should be emailed. Empty = database only.
CONTACT_NOTIFICATION_EMAIL=

# SMTP relay used for the notification above. Leave empty to keep email disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
